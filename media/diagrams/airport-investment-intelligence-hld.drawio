          <mxGeometry x="40" y="300" width="1200" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="chat" value="&lt;b&gt;chat()&lt;/b&gt;&lt;br&gt;Keyword intent in parallel with LLM classify&lt;br&gt;Codes must exist in the catalog&lt;br&gt;Keyword intents win when present&lt;br&gt;History window: last 12 messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="20" y="48" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="intents" value="&lt;b&gt;Intents&lt;/b&gt;&lt;br&gt;ranking · compare · metrics&lt;br&gt;long_haul · demand_pressure&lt;br&gt;unsupported → catalog counts and examples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="320" y="48" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="queries" value="&lt;b&gt;Queries&lt;/b&gt;&lt;br&gt;ranking(region, limit)&lt;br&gt;compare(up to 4 codes)&lt;br&gt;metric_response(code)&lt;br&gt;East Coast ≠ New England" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="620" y="48" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="brief" value="&lt;b&gt;briefing.py&lt;/b&gt;&lt;br&gt;Always four headings:&lt;br&gt;Direct answer&lt;br&gt;Evidence and method&lt;br&gt;Scope and uncertainty · Conclusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="890" y="48" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="livec" value="&lt;b&gt;LiveContextJobs&lt;/b&gt;&lt;br&gt;Prefetch up to 2 codes while classify runs&lt;br&gt;Ranking and compare: top 2 · others: 1&lt;br&gt;attach_live_context after the memo exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="20" y="220" width="360" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ctx" value="&lt;b&gt;services.context&lt;/b&gt;&lt;br&gt;Pool of 5: facilities, NAS, METAR, Census, BLS&lt;br&gt;County geocode when U.S. state and coordinates exist&lt;br&gt;ENVIRONMENT=test returns unavailable stubs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="400" y="220" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;Explanation guard&lt;/b&gt;&lt;br&gt;explain() may replace wording only&lt;br&gt;Invented number or source → fallback&lt;br&gt;ai_status: generated or fallback:reason&lt;br&gt;Calls recorded on the provider object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="svc">
          <mxGeometry x="820" y="220" width="350" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="domain" value="Domain — no I/O" style="swimlane;startSize=28;fillColor=#fdecec;strokeColor=#b85450;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="300" width="740" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="scoring" value="&lt;b&gt;domain.scoring&lt;/b&gt;&lt;br&gt;kpi_tier · airport_metrics&lt;br&gt;expansion_opportunity_score&lt;br&gt;long_haul_share (≥ 1,500 mi)&lt;br&gt;demand_pressure_proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="domain">
          <mxGeometry x="24" y="50" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="weights" value="&lt;b&gt;Weights, bts_scored only&lt;/b&gt;&lt;br&gt;Passenger growth 35%&lt;br&gt;Departure delay ≥15 min 30%&lt;br&gt;Cancellation 20%&lt;br&gt;Log10 departures / log10(200k) 15%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="domain">
          <mxGeometry x="364" y="50" width="350" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="tiers" value="&lt;b&gt;KPI tiers&lt;/b&gt;&lt;br&gt;bts_scored — full 0–100&lt;br&gt;enplanement_only — boardings, no score&lt;br&gt;identity — name, city, country, ICAO, METAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="domain">
          <mxGeometry x="24" y="230" width="690" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="persist" value="Persistence and admin" style="swimlane;startSize=28;fillColor=#f6f0f8;strokeColor=#9673a6;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1980" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="repos" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;UserRepository&lt;br&gt;ConversationRepository&lt;br&gt;Every conversation query includes user id&lt;br&gt;Delete cascades messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="20" y="48" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="models" value="&lt;b&gt;SQLAlchemy models + Alembic&lt;/b&gt;&lt;br&gt;SQLite for local and unit work&lt;br&gt;Postgres in CI and production&lt;br&gt;Non-production startup seeds reference data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="340" y="48" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="llmruns" value="&lt;b&gt;llm_runs&lt;/b&gt;&lt;br&gt;provider, model, purpose, status&lt;br&gt;latency and token counts&lt;br&gt;conversation set null on delete&lt;br&gt;Prompts and credentials are not stored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="680" y="48" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;auth_audit_events&lt;/b&gt;&lt;br&gt;Written on successful login&lt;br&gt;request id from middleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="1020" y="48" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;airport-admin CLI&lt;/b&gt;&lt;br&gt;sync-users from allowlist.json&lt;br&gt;seed-catalog · ingest-catalog&lt;br&gt;ingest-faa-cy2025 · ingest-bts-year&lt;br&gt;purge-conversations --days 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="1300" y="48" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="factory" value="&lt;b&gt;LLM factory&lt;/b&gt;&lt;br&gt;Request override groq|gemini&lt;br&gt;else settings.llm_provider&lt;br&gt;Timeout capped at 12s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="persist">
          <mxGeometry x="1640" y="48" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="r4" target="chat">
