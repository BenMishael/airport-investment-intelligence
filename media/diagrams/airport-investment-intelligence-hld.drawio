  </diagram>
  <diagram id="deploy" name="08 Deployment and Operations">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Deployment, delivery, and operations" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="640" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="gh" value="GitHub" style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="620" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="ci" value="&lt;b&gt;Path-filtered CI&lt;/b&gt;&lt;br&gt;Triggers on api, web, compose, render, workflow&lt;br&gt;gitleaks on every run&lt;br&gt;API: uv, ruff, mypy, pytest, alembic on Postgres 16, pip-audit&lt;br&gt;Web: Node from .nvmrc, lint, typecheck, Vitest, Playwright, build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="gh">
          <mxGeometry x="20" y="48" width="580" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;One repository, two deployables&lt;/b&gt;&lt;br&gt;Web root directory: web&lt;br&gt;API Docker context: api/ · copies catalog.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="gh">
          <mxGeometry x="20" y="200" width="580" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hosts" value="Production hosts" style="swimlane;startSize=28;fillColor=#eef5fb;strokeColor=#6c8ebf;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="1220" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="vercel" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;Next.js workspace&lt;br&gt;NEXT_PUBLIC_API_BASE_URL&lt;br&gt;NEXT_PUBLIC_SUPABASE_URL&lt;br&gt;NEXT_PUBLIC_SUPABASE_ANON_KEY&lt;br&gt;NEXT_PUBLIC_DEFAULT_LLM_PROVIDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="hosts">
          <mxGeometry x="20" y="50" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="apihost" value="&lt;b&gt;Render or Railway&lt;/b&gt;&lt;br&gt;ENVIRONMENT=production&lt;br&gt;AUTH_REQUIRED=true&lt;br&gt;Pooled DATABASE_URL&lt;br&gt;CORS_ORIGINS = Vercel host only&lt;br&gt;SUPABASE_URL, JWT audience&lt;br&gt;GROQ_API_KEY, optional Gemini, Census, BLS&lt;br&gt;Health check: /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="hosts">
          <mxGeometry x="320" y="50" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="supa" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;Public signup disabled&lt;br&gt;Custom SMTP&lt;br&gt;Redirect URLs = Vercel origin&lt;br&gt;allowlist.json stays uncommitted&lt;br&gt;Alembic upgrade head before traffic&lt;br&gt;seed-catalog and sync-users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="hosts">
          <mxGeometry x="640" y="50" width="270" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;Local parity&lt;/b&gt;&lt;br&gt;docker compose up --build&lt;br&gt;API :8000 health, then web :3000&lt;br&gt;uvicorn --reload and npm run dev without Docker&lt;br&gt;SQLite allowed for unit work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="hosts">
          <mxGeometry x="930" y="50" width="260" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ingest" value="Offline catalog build" style="swimlane;startSize=28;fillColor=#fff6ea;strokeColor=#d79b00;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1880" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="oa" value="&lt;b&gt;OurAirports CSV&lt;/b&gt;&lt;br&gt;Downloaded if omitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ingest">
          <mxGeometry x="20" y="60" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="faa" value="&lt;b&gt;FAA CY2025&lt;/b&gt;&lt;br&gt;ingest-faa-cy2025&lt;br&gt;optional enplanement CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ingest">
          <mxGeometry x="280" y="50" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bts" value="&lt;b&gt;BTS on-time&lt;/b&gt;&lt;br&gt;ingest-bts-year&lt;br&gt;monthly zips, aggregated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ingest">
          <mxGeometry x="550" y="50" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;ingest-catalog&lt;/b&gt;&lt;br&gt;Writes data/catalog.json&lt;br&gt;Counts scored, enplanement-only, and identity rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ingest">
          <mxGeometry x="840" y="50" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="image" value="&lt;b&gt;API image&lt;/b&gt;&lt;br&gt;Snapshot copied in&lt;br&gt;Exam KPI overlay at load&lt;br&gt;No snapshot → 11-airport fixture" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;boundedLbl=1;" vertex="1" parent="ingest">
          <mxGeometry x="1180" y="40" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="seedpg" value="&lt;b&gt;seed-catalog&lt;/b&gt;&lt;br&gt;Idempotent copy of reference rows into Postgres. Separate from the in-memory score path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="ingest">
          <mxGeometry x="1480" y="50" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="Release checks and operations" style="swimlane;startSize=28;fillColor=#fdecec;strokeColor=#b85450;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1880" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="go" value="&lt;b&gt;Go-live checks&lt;/b&gt;&lt;br&gt;/health and /ready&lt;br&gt;OTP sign-in on the Vercel origin&lt;br&gt;Authenticated ranking&lt;br&gt;History ownership and deletion&lt;br&gt;Sign-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ops">
          <mxGeometry x="20" y="50" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;Runtime operations&lt;/b&gt;&lt;br&gt;Migrations before deploy&lt;br&gt;Daily 30-day conversation purge&lt;br&gt;Watch readiness, provider latency, and fallback rate&lt;br&gt;Wake free-tier Supabase before a demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ops">
          <mxGeometry x="330" y="50" width="360" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="sec" value="&lt;b&gt;Trust boundary&lt;/b&gt;&lt;br&gt;Browser: anon key and user JWT only.&lt;br&gt;API: service role, database URL, and model keys.&lt;br&gt;Groq receives the question, short history, and retrieved evidence.&lt;br&gt;Interactive API docs disabled in production.&lt;br&gt;CORS is an allow-list of exact origins." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ops">
          <mxGeometry x="720" y="50" width="520" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="res" value="&lt;b&gt;Failure behavior&lt;/b&gt;&lt;br&gt;Model down or rejected rewrite: deterministic memo.&lt;br&gt;Live provider timeout: section marked unavailable.&lt;br&gt;Non-U.S. airport: skip NAS, facilities, Census, and BLS.&lt;br&gt;Test environment: fixture catalog and stubbed providers, so pytest stays offline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ops">
          <mxGeometry x="1270" y="50" width="570" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="deploy web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;fontSize=11;" edge="1" parent="1" source="ci" target="vercel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="deploy API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;fontSize=11;" edge="1" parent="1" source="ci" target="apihost">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="oa" target="build">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="faa" target="build">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="bts" target="build">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="build" target="image">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="vercel" target="apihost">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="JWKS and SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="apihost" target="supa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
