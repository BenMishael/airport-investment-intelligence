  <diagram id="web" name="04 Web Workspace">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Web workspace — component view" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="shell" value="Browser shell" style="swimlane;startSize=28;fillColor=#eef5fb;strokeColor=#6c8ebf;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1580" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="mw" value="&lt;b&gt;middleware.ts&lt;/b&gt;&lt;br&gt;Host 127.0.0.1:3000 redirects 308 to localhost so OTP origin matches. Static assets are excluded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="shell">
          <mxGeometry x="24" y="48" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="layout" value="&lt;b&gt;App shell&lt;/b&gt;&lt;br&gt;layout, Header, BrandMark&lt;br&gt;ThemeProvider, MotionProvider&lt;br&gt;ViewportFit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="shell">
          <mxGeometry x="410" y="48" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="authp" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;AuthProvider · SignIn · ProtectedApp&lt;br&gt;Supabase email OTP&lt;br&gt;Session access token for the API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="shell">
          <mxGeometry x="720" y="48" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sbclient" value="&lt;b&gt;Supabase browser client&lt;/b&gt;&lt;br&gt;URL + anon key only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="shell">
          <mxGeometry x="1110" y="48" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ws" value="Workspace" style="swimlane;startSize=26;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="shell">
          <mxGeometry x="24" y="170" width="1520" height="610" as="geometry"/>
        </mxCell>
        <mxCell id="starters" value="&lt;b&gt;Empty state&lt;/b&gt;&lt;br&gt;Starter questions&lt;br&gt;New England ranking&lt;br&gt;Compare, long-haul, demand proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="20" y="48" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="composer" value="&lt;b&gt;Composer&lt;/b&gt;&lt;br&gt;Question text&lt;br&gt;Groq / Gemini toggle&lt;br&gt;Voice dictation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="290" y="48" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="answer" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;MarkdownAnswer&lt;br&gt;Four briefing headings&lt;br&gt;ai_status surfaced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="540" y="48" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;Evidence panel&lt;/b&gt;&lt;br&gt;Score, components, sources&lt;br&gt;KPI tier and coverage note&lt;br&gt;Live context labeled supplemental" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="790" y="48" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rank" value="&lt;b&gt;Ranking view&lt;/b&gt;&lt;br&gt;Desktop table&lt;br&gt;Compact cards on small screens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="1090" y="48" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;History drawer&lt;/b&gt;&lt;br&gt;List, open, delete&lt;br&gt;ConfirmDialog&lt;br&gt;Owner-scoped on the API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="20" y="210" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="apifetch" value="&lt;b&gt;lib/api/client&lt;/b&gt;&lt;br&gt;apiFetch(path, accessToken)&lt;br&gt;JSON errors with request id&lt;br&gt;204 for delete · 408 on timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="290" y="210" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="motion" value="&lt;b&gt;Motion assets&lt;/b&gt;&lt;br&gt;route-network&lt;br&gt;evidence-scan&lt;br&gt;result-resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="590" y="210" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;What the browser must not hold&lt;/b&gt;&lt;br&gt;Service role key, database URL, SMTP, Groq, Gemini, Census, or BLS keys. None of these are NEXT_PUBLIC." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="820" y="200" width="660" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;Web verification&lt;/b&gt;&lt;br&gt;ESLint · tsc · Vitest · Prettier · next build&lt;br&gt;Playwright: functional, history, responsive, visual, shock, fuzz, immunity, resilience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="ws">
          <mxGeometry x="20" y="380" width="1460" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="composer" target="apifetch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="apifetch" target="answer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="authp" target="sbclient">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="access token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="authp" target="apifetch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="chat" name="05 Chat and Auth Flow">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1320" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Chat request and authorization" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="640" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="POST /chat. Score and memo are fixed before the model rewrite and before live context is attached." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="Analyst submits a question and optional Groq or Gemini override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Browser sends Bearer JWT. Client aborts at 15 seconds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="Token present and auth configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="401 session invalid or missing. 503 if Supabase is not configured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="240" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="JWKS verify RS256 or ES256. Require exp, sub, email, audience, issuer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="90" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="app_users row active and email matches subject?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="80" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="403 account is not authorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="240" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="Load owned conversation or create one. 404 if the id is not owned. Store the user message." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="90" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="Deterministic keyword intent and catalog code resolution, including prior turns if this message names none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="In parallel: prefetch live context for up to two codes, and LLM classify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="Merge intents. Unknown codes dropped. Keyword intent wins. Compare with one code becomes metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="370" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="Build evidence from the snapshot: ranking, compare, metrics, long-haul, or demand proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="370" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="0–100 only when kpi_tier is bts_scored and required fields exist. Empty region ranking falls back to New England." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="360" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="Deterministic four-heading memo from evidence alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="Second model call: rewrite wording?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="530" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="Accept rewrite. ai_status = generated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="Keep deterministic memo. ai_status = fallback:reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="620" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="Attach live context for the evidence codes. Unavailable sections stay explicit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="Persist assistant message, assumptions, ai_status, and llm_runs metadata. Return answer, intent, evidence, conversation id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="530" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="assumptions" value="&lt;b&gt;Assumptions always returned&lt;/b&gt;&lt;br&gt;Metrics use the checked-in FAA CY2025 / BTS CY2024 snapshot where those KPIs exist.&lt;br&gt;Operational pressure does not establish a need for terminal expansion or predict profitability.&lt;br&gt;Live public APIs are supplemental and never change the 0–100 score.&lt;br&gt;A coverage note is appended when the evidence carries one." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="900" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ownership" value="&lt;b&gt;History rules&lt;/b&gt;&lt;br&gt;List, get, and delete all filter by the internal user id.&lt;br&gt;A foreign conversation id is a 404, not another user’s data.&lt;br&gt;Retention is 30 days via airport-admin purge-conversations.&lt;br&gt;Deleting a conversation cascades messages. llm_runs keep a null conversation id." style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="760" width="800" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="n3" target="n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
