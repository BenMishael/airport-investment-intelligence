  <diagram id="scoring" name="07 Scoring and Evidence">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Scoring and evidence rules" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="row" value="Airport row from catalog snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="tier" value="kpi_tier" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="bts" value="&lt;b&gt;bts_scored&lt;/b&gt;&lt;br&gt;U.S. commercial service&lt;br&gt;2024 BTS on-time counts&lt;br&gt;plus FAA enplanements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="eno" value="&lt;b&gt;enplanement_only&lt;/b&gt;&lt;br&gt;FAA boardings shown&lt;br&gt;No expansion score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="180" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ident" value="&lt;b&gt;identity&lt;/b&gt;&lt;br&gt;Name, city, country, ICAO&lt;br&gt;METAR if NOAA returns one&lt;br&gt;No expansion score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="310" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fields" value="Required fields present? enplanements, departures, delayed, cancelled, avg delay, avg taxi-out, growth" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="20" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="rates" value="&lt;b&gt;Rates&lt;/b&gt;&lt;br&gt;Delay = delayed ≥15 min / departures&lt;br&gt;Cancel = cancelled / departures&lt;br&gt;Null when departures are 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="40" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="comp" value="&lt;b&gt;Components, each clamped 0–100&lt;/b&gt;&lt;br&gt;Growth: (growth + 2) / 12 × 100 · weight 0.35&lt;br&gt;Delay: (delay rate − 10) / 20 × 100 · weight 0.30&lt;br&gt;Cancel: cancel rate / 4 × 100 · weight 0.20&lt;br&gt;Activity: log10(departures) / log10(200000) × 100 · weight 0.15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="620" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="screen" value="Round to one decimal. Screening signal, not utilization, causation, or return." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="350" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Demand pressure proxy&lt;/b&gt;&lt;br&gt;Delayed departures + cancelled departures.&lt;br&gt;Not measured unmet passenger demand.&lt;br&gt;Unmet demand would need bookings, fares, and capacity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="420" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="haul" value="&lt;b&gt;Long haul&lt;/b&gt;&lt;br&gt;Nonstop segment of at least 1,500 statute miles.&lt;br&gt;Matched T-100 numerator and denominator.&lt;br&gt;Omitted when route fields are absent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="480" width="420" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="regions" value="&lt;b&gt;Regions&lt;/b&gt;&lt;br&gt;New England stays its own region so the exam ranking is unchanged.&lt;br&gt;East Coast means Atlantic-seaboard scored airports, Maine through Florida." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="500" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="memo" value="Deterministic briefing from evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rewrite" value="Rewrite keeps every number and source?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="620" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="yes" value="Show model wording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="600" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="no" value="Show deterministic memo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="attach" value="Attach live context. It cannot change the score." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1020" y="660" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="livebox" value="&lt;b&gt;Live context policy&lt;/b&gt;&lt;br&gt;NOAA METAR: worldwide, 60-minute cache, needs ICAO.&lt;br&gt;FAA NAS: U.S. only, 5-minute cache.&lt;br&gt;FAA facilities: U.S. only, 24-hour cache.&lt;br&gt;Census ACS and BLS: U.S. catchment after geocode. Keys optional.&lt;br&gt;Each adapter: short timeout, one retry, provenance, explicit unavailable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="760" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="trade" value="&lt;b&gt;Tradeoffs&lt;/b&gt;&lt;br&gt;A full IATA directory is cheap. Comparable delay scores are not: BTS coverage is U.S. reporting carriers.&lt;br&gt;Annual aggregates stay reproducible. Live APIs are request-time context.&lt;br&gt;Delayed plus cancelled departures are observable. True unmet demand is not in the public files." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="840" width="900" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="row" target="tier">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="bts_scored" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="tier" target="bts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="enplanement_only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="tier" target="eno">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="tier" target="ident">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="bts" target="fields">
