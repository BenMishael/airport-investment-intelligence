  <diagram id="data" name="06 Data Model">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1280" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Logical data model" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Runtime 0–100 scores are computed from the in-memory catalog snapshot. Postgres holds identity, history, audit, and seeded reference rows. Chat does not recalculate a score by querying airport_metrics." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="16" width="1100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="users" value="Owned workspace" style="swimlane;startSize=28;fillColor=#f6f0f8;strokeColor=#9673a6;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="980" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="app_users" value="&lt;b&gt;app_users&lt;/b&gt;&lt;br&gt;id PK&lt;br&gt;supabase_user_id UK&lt;br&gt;email UK&lt;br&gt;is_allowed&lt;br&gt;last_login_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="24" y="50" width="200" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="conversations" value="&lt;b&gt;conversations&lt;/b&gt;&lt;br&gt;id PK&lt;br&gt;user_id FK cascade&lt;br&gt;title&lt;br&gt;created_at, updated_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="280" y="50" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="messages" value="&lt;b&gt;messages&lt;/b&gt;&lt;br&gt;id PK&lt;br&gt;conversation_id FK cascade&lt;br&gt;role, content&lt;br&gt;evidence JSON&lt;br&gt;assumptions and ai_status stored inside evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="560" y="40" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="llm_runs" value="&lt;b&gt;llm_runs&lt;/b&gt;&lt;br&gt;conversation_id FK set null&lt;br&gt;provider, model, purpose, status&lt;br&gt;latency_ms, input_tokens, output_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="280" y="250" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="audit_ev" value="&lt;b&gt;auth_audit_events&lt;/b&gt;&lt;br&gt;user_id FK set null&lt;br&gt;event_type, result&lt;br&gt;request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="24" y="250" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;provider_cache&lt;/b&gt;&lt;br&gt;key PK · provider&lt;br&gt;payload JSON · expires_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="600" y="250" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="runs" value="&lt;b&gt;ingestion_runs&lt;/b&gt;&lt;br&gt;provider, status&lt;br&gt;records_processed, error_summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="users">
          <mxGeometry x="600" y="370" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ref" value="Aviation reference (seeded)" style="swimlane;startSize=28;fillColor=#eef7ea;strokeColor=#82b366;fontStyle=1;html=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="110" width="960" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="airports" value="&lt;b&gt;airports&lt;/b&gt;&lt;br&gt;iata UK · icao UK&lt;br&gt;name, city, state, region&lt;br&gt;country_iso, country_name&lt;br&gt;kpi_tier, airport_type, continent&lt;br&gt;latitude, longitude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ref">
          <mxGeometry x="24" y="50" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="aliases" value="&lt;b&gt;airport_aliases&lt;/b&gt;&lt;br&gt;airport_id + alias unique&lt;br&gt;cascade on airport delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="340" y="50" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;airport_metrics&lt;/b&gt;&lt;br&gt;unique airport, metric, period&lt;br&gt;value, unit&lt;br&gt;period_start, period_end&lt;br&gt;source_snapshot_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ref">
          <mxGeometry x="340" y="170" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="routes" value="&lt;b&gt;route_metrics&lt;/b&gt;&lt;br&gt;origin_airport_id&lt;br&gt;destination_code&lt;br&gt;metric, value, observed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="620" y="50" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fac" value="&lt;b&gt;facility_snapshots&lt;/b&gt;&lt;br&gt;airport_id, source_id&lt;br&gt;payload JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="620" y="190" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;data_sources&lt;/b&gt;&lt;br&gt;id, name, publisher&lt;br&gt;url, license" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="24" y="260" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="snaps" value="&lt;b&gt;source_snapshots&lt;/b&gt;&lt;br&gt;source_id FK&lt;br&gt;observed_at, fetched_at&lt;br&gt;checksum, metadata JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="24" y="390" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="regional" value="&lt;b&gt;regional_indicators&lt;/b&gt;&lt;br&gt;region_key, indicator, value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="340" y="360" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;operational_events&lt;/b&gt;&lt;br&gt;airport_code, event_type, status&lt;br&gt;started_at, ended_at, payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ref">
          <mxGeometry x="620" y="320" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="window" value="&lt;b&gt;Snapshot contract&lt;/b&gt;&lt;br&gt;BTS window 2024-01-01/2024-12-31&lt;br&gt;FAA window 2025-01-01/2025-12-31&lt;br&gt;Exam airports keep checked-in aggregates so BOS, LAX, SNA, ANC, and SFO cannot drift.&lt;br&gt;Missing catalog.json falls back to the 11-airport fixture." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ref">
          <mxGeometry x="24" y="530" width="880" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="app_users" target="conversations">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="conversations" target="messages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="app_users" target="audit_ev">
